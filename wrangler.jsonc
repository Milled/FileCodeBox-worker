{
  // Worker 名称：同一 Cloudflare 账号下必须唯一，冲突时改成你自己的名字
  "name": "filecodebox",
  "main": "src/index.ts",
  // 故意不写 account_id：wrangler 使用当前 `wrangler login` 的账号，
  // 账号下有多个 profile 时会交互式让你选择并回填
  "compatibility_date": "2025-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "vars": {
    // 单文件上限（字节），26214400 = 25MB。
    // 管理员后台 PATCH /api/admin/config/update 写入的值优先于此（见 src/shared.ts resolveLimits）
    "MAX_FILE_SIZE": "26214400",
    // 默认过期天数，同样可被后台设置覆盖
    "DEFAULT_EXPIRE_DAYS": "7"
  },
  // database_id 留空即可：运行 `npm run provision` 会自动创建同名 D1 并回填此字段。
  // 如需自定义资源名，改 database_name / bucket_name 后重新运行 provision。
  "d1_databases": [{
    "binding": "DB",
    "database_name": "filecodebox-db",
    "database_id": ""
  }],
  // R2 只需桶名（无 ID），桶本身同样由 `npm run provision` 创建
  "r2_buckets": [{
    "binding": "FILE_STORE",
    "bucket_name": "filecodebox-file"
  }]
}
